		<locator by="xpath" value="//*[@id='collapseChild']/div/div[2]/div[1]" desc="3"></locator>
		<locator by="xpath" value="//*[@id='permission']" desc="4"></locator>
		<locator by="xpath" value="//*[@id='allow']" desc="5"></locator>
